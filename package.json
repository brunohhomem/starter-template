{
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=12.14.0 <13"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
