# =============================================================================
# Ambiente
# =============================================================================
NODE_ENV=development
API_PORT=3001
APP_ORIGIN=http://localhost:3000
# Origin da API para o rewrite /api do Next (apps/web). Sem barra final.
API_ORIGIN=http://localhost:3001
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
SWAGGER_ENABLED=true

# =============================================================================
# Banco de dados (PostgreSQL 18)
# =============================================================================
DB_HOST=localhost
DB_PORT=15432
DB_USER=app
DB_PASSWORD=
DB_NAME=app
DB_POOL_MAX=10
TEST_DB_NAME=app_test

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=

# =============================================================================
# Chaves geradas automaticamente (pnpm keys:generate)
# NÃO EDITE MANUALMENTE — use pnpm keys:generate / pnpm keys:rotate
# =============================================================================
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=

# =============================================================================
# Definidas por você (obrigatórias em produção)
# =============================================================================
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# =============================================================================
# Auth (F2) - Configurações de autenticação
# =============================================================================
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=7
AUTH_REFRESH_REUSE_GRACE_SECONDS=10
AUTH_BCRYPT_ROUNDS=12

# =============================================================================
# Mail (F3) - Configurações de e-mail
# =============================================================================
MAIL_DRIVER=smtp
MAIL_FROM=Starter <no-reply@localhost>
APP_NAME=Starter Template
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=
EMAIL_CONFIRM_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
INVITE_TTL_DAYS=7

# Credenciais de provedores externos (opcionais, F9)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=