# =============================================================================
# Ambiente
# =============================================================================
NODE_ENV=development
API_PORT=3001
APP_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
SWAGGER_ENABLED=true

# =============================================================================
# Banco de dados (PostgreSQL 18)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=
DB_NAME=app
DB_POOL_MAX=10
TEST_DB_NAME=app_test

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# Chaves geradas automaticamente (pnpm keys:generate)
# NÃO EDITE MANUALMENTE — use pnpm keys:generate / pnpm keys:rotate
# =============================================================================
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=

# =============================================================================
# Definidas por você (obrigatórias em produção)
# =============================================================================
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
# ADMIN_INITIAL_PASSWORD=

# Credenciais de provedores externos (opcionais, F2/F9)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=