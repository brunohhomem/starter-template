{
  "name": "@starter/shared",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./email": {
      "types": "./dist/email.d.ts",
      "default": "./dist/email.js"
    },
    "./people": {
      "types": "./dist/people.d.ts",
      "default": "./dist/people.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@starter/config": "workspace:*",
    "@types/node": "^26.6.5",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
