{
  "name": "@starter/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run -c vitest.config.mjs",
    "test:integration": "vitest run -c vitest.integration.config.mjs",
    "db:generate": "tsx scripts/db-generate.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:studio": "tsx scripts/db-studio.ts",
    "worker": "node dist/worker.js",
    "worker:dev": "nest start --watch --entryFile worker"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@starter/shared": "workspace:*",
    "@types/supertest": "^7.2.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.4.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "0.44.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "4.2.0",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.2.0",
    "pg": "8.13.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "0.2.2",
    "resend": "^6.34.1",
    "rxjs": "7.8.2",
    "supertest": "^7.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@starter/config": "workspace:*",
    "@swc/core": "^1.16.18",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "0.31.1",
    "eslint": "9.39.5",
    "pino-pretty": "13.0.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
